# Nusxa oling:  cp .env.example .env   (Windows: copy .env.example .env)
PORT=3000
APP_SECRET=bu-yerga-uzun-tasodifiy-satr-yozing
TZ_NAME=Asia/Tashkent
DEMO_HINT=true

# --- SMS (Eskiz.uz) ---  console = faqat terminalga yozadi (sinov uchun)
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
